# Database Configuration
DATABASE_URL=postgresql://mnair:mnair_password@localhost:5433/mnair_db
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=mnair_db
DATABASE_USER=mnair
DATABASE_PASSWORD=mnair_password

# Redis Configuration
REDIS_URL=redis://localhost:6380/0
REDIS_HOST=localhost
REDIS_PORT=6380
# REQUIRED for production — generate with: python -c "import secrets; print(secrets.token_hex(32))"
REDIS_PASSWORD=REPLACE_WITH_REAL_PASSWORD

# MinIO/S3 Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mnair-certificates
MINIO_SECURE=false

# JWT Configuration
# REQUIRED — generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=REPLACE_WITH_REAL_SECRET_MIN_64_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080

# API Keys - Nigerian SMS/WhatsApp Providers
# Termii (SMS/WhatsApp)
TERMII_API_KEY=your_termii_api_key_here
TERMII_SENDER_ID=MNAIR

# Africa's Talking (USSD/SMS)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your_africastalking_api_key_here
AFRICASTALKING_USSD_CODE=*384*8080#

# Meta WhatsApp Business API
META_WHATSAPP_TOKEN=your_meta_whatsapp_token_here
META_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
META_VERIFY_TOKEN=your_webhook_verify_token_here
META_WEBHOOK_SECRET=your_webhook_secret_here

# KingsChat (browser-automation channel — no official bot API)
# Off by default. When true, KINGSCHAT_ACCOUNT_EMAIL/PASSWORD,
# KINGSCHAT_SESSION_STORE_PATH, and KINGSCHAT_SESSION_ENCRYPTION_KEY are
# required at startup (see app/config.py's validator). Run via
# `docker compose --profile kingschat up -d kingschat_bot`, or locally with
# `python kingschat_bot.py --live --loop` (defaults to --dry-run).
KINGSCHAT_ENABLED=false
KINGSCHAT_ACCOUNT_EMAIL=your_kingschat_account_email_here
KINGSCHAT_ACCOUNT_PASSWORD=your_kingschat_account_password_here
# Encrypted session file — NEVER commit this path's target to git, even
# though it's encrypted at rest. Local default matches kingschat_bot.py's
# working directory; the docker-compose kingschat_bot service overrides
# this to a path inside its own named volume.
KINGSCHAT_SESSION_STORE_PATH=./kingschat.session
# REQUIRED when KINGSCHAT_ENABLED=true — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KINGSCHAT_SESSION_ENCRYPTION_KEY=REPLACE_WITH_REAL_FERNET_KEY
# The handle (without '@') the bot session MUST be logged in as. The bot
# verifies this after every login/session restore and refuses to run as any
# other account — protects against a stale session file or wrong credentials
# silently sending lessons from someone's personal account (this actually
# happened during the first live test).
KINGSCHAT_EXPECTED_USERNAME=your_bot_account_handle_here
# Pooled BrowserContext count sharing one Chromium process.
KINGSCHAT_POOL_SIZE=10
# Per-context proxy (host:port), only needed if the fingerprint-isolation
# research in TODOS.md concludes pooled contexts need separate egress IPs.
# Empty = no proxy.
KINGSCHAT_CONTEXT_PROXY_SERVER=

# Application Configuration
APP_NAME=Make Nigeria AI Ready
APP_ENV=development
APP_DEBUG=true
API_VERSION=v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Admin Configuration
ADMIN_EMAIL=admin@mnair.gov.ng
ADMIN_PASSWORD=change_this_password

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

# Security
# REQUIRED — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=REPLACE_WITH_REAL_SECRET
RATE_LIMIT_PER_MINUTE=60

# Nigeria Data Protection Act (NDPA) Compliance
DATA_RETENTION_DAYS=90
CONSENT_REQUIRED=true

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Email Configuration (Optional - for admin notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_email_password
SMTP_FROM_EMAIL=noreply@mnair.gov.ng
