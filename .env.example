# Database Configuration
DATABASE_URL=postgresql://mnair:mnair_password@localhost:5432/mnair_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=mnair_db
DATABASE_USER=mnair
DATABASE_PASSWORD=mnair_password

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO/S3 Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mnair-certificates
MINIO_SECURE=false

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080

# API Keys - Nigerian SMS/WhatsApp Providers
# Termii (SMS/WhatsApp)
TERMII_API_KEY=your_termii_api_key_here
TERMII_SENDER_ID=MNAIR

# Africa's Talking (USSD/SMS)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your_africastalking_api_key_here
AFRICASTALKING_USSD_CODE=*384*8080#

# Meta WhatsApp Business API
META_WHATSAPP_TOKEN=your_meta_whatsapp_token_here
META_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
META_VERIFY_TOKEN=your_webhook_verify_token_here
META_WEBHOOK_SECRET=your_webhook_secret_here

# Application Configuration
APP_NAME=Make Nigeria AI Ready
APP_ENV=development
APP_DEBUG=true
API_VERSION=v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Admin Configuration
ADMIN_EMAIL=admin@mnair.gov.ng
ADMIN_PASSWORD=change_this_password

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security
SESSION_SECRET=your-session-secret-change-this
RATE_LIMIT_PER_MINUTE=60

# Nigeria Data Protection Act (NDPA) Compliance
DATA_RETENTION_DAYS=90
CONSENT_REQUIRED=true

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Email Configuration (Optional - for admin notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_email_password
SMTP_FROM_EMAIL=noreply@mnair.gov.ng
